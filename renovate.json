{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>datum-cloud/.github:renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "scripts/vuln-scan/testdata/**",
    "scripts/code-scan/testdata/**",
    "scripts/lockfile-check/testdata/**",
    "scripts/activity-policies/testdata/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Scanner versions pinned in the vulnerability scan's installer",
      "managerFilePatterns": [
        "/^scripts/vuln-scan/install-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "datumctl version pinned in the plugin catalog's installer",
      "managerFilePatterns": [
        "/^scripts/plugin-catalog/install-datumctl\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "activitytool image tag and digest pinned in the activity-policies installer (the default activitytool-version)",
      "managerFilePatterns": [
        "/^scripts/activity-policies/install-activitytool\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nPINNED_VERSION=(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\nPINNED_VERSION={{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "activitytool image tag and digest in the README's consumer Taskfile snippet; kept equal to the installer pin by test-activity-policies.sh",
      "managerFilePatterns": [
        "/^docs/activity-policies/README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n  ACTIVITYTOOL_VERSION: (?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\n  ACTIVITYTOOL_VERSION: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^scripts/code-scan/requirements\\.txt$/",
      "/^scripts/plugin-catalog/requirements\\.txt$/"
    ]
  },
  "constraints": {
    "python": "3.11"
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "requirements.txt is a pip-compile lock; let the pip-compile manager own it",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "scripts/code-scan/requirements.txt",
        "scripts/plugin-catalog/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "activitytool: stable milo-os/activity releases only (never v0.0.0-* branch builds or floating vX / vX.Y tags), pinned by digest, one PR for every copy of the pin",
      "matchDepNames": [
        "ghcr.io/milo-os/activitytool"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "pinDigests": true,
      "groupName": "activitytool"
    }
  ]
}
