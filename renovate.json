{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>datum-cloud/.github:renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "scripts/vuln-scan/testdata/**",
    "scripts/code-scan/testdata/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Scanner versions pinned in the vulnerability scan's installer",
      "managerFilePatterns": [
        "/^scripts/vuln-scan/install-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "datumctl version pinned in the plugin catalog's installer",
      "managerFilePatterns": [
        "/^scripts/plugin-catalog/install-datumctl\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^scripts/code-scan/requirements\\.txt$/",
      "/^scripts/plugin-catalog/requirements\\.txt$/"
    ]
  },
  "constraints": {
    "python": "3.11"
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "requirements.txt is a pip-compile lock; let the pip-compile manager own it",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "scripts/code-scan/requirements.txt",
        "scripts/plugin-catalog/requirements.txt"
      ],
      "enabled": false
    }
  ]
}
