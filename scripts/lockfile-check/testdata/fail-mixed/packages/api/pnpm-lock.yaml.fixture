lockfileVersion: '9.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:

  .:
    dependencies:
      left-pad:
        specifier: ^1.3.0
        version: 1.3.0
      shared:
        specifier: workspace:*
        version: link:packages/shared

  packages/app:
    dependencies:
      shared:
        specifier: workspace:*
        version: link:../shared
      react:
        specifier: ^18
        version: 18.2.0(react-dom@18.2.0)
      mirrored:
        specifier: ^1.0.0
        version: 1.0.0

packages:

  left-pad@1.3.0:
    resolution: {integrity: sha512-x}
    deprecated: use String.prototype.padStart()

  '@scope/pkg@1.0.0':
    resolution: {integrity: sha512-y}

  mirrored@1.0.0:
    resolution: {integrity: sha512-z, tarball: https://registry.npmjs.org/mirrored/-/mirrored-1.0.0.tgz}

  local-dir@file:vendor/local-dir:
    resolution: {directory: vendor/local-dir, type: directory}

snapshots:

  left-pad@1.3.0: {}

  '@scope/pkg@1.0.0':
    dependencies:
      left-pad: 1.3.0
