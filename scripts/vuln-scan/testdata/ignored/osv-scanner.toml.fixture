# Every entry needs a reason and an ignoreUntil at most 12 months away. The
# test replaces IGNORE_UNTIL with a date relative to the day it runs.
# GO-2022-1059 is ignored through its CVE alias.

[[IgnoredVulns]]
id = "GO-2021-0113"
ignoreUntil = IGNORE_UNTIL
reason = "Fixture: proves govulncheck findings honor osv-scanner.toml."

